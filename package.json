{
  "name": "kinetic-press",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "node --disable-warning=ExperimentalWarning scripts/dev.ts",
    "dev:client": "vite",
    "dev:server": "node --disable-warning=ExperimentalWarning --watch server/main.ts",
    "dashboard:extension": "node --disable-warning=ExperimentalWarning scripts/project-dashboard-extension.ts",
    "theseus": "theseus",
    "loop:status": "node --disable-warning=ExperimentalWarning scripts/theseus-loop-status.ts",
    "check:codex-reliability": "node --disable-warning=ExperimentalWarning scripts/check-codex-reliability.ts",
    "test:loop-reliability": "node --disable-warning=ExperimentalWarning --test scripts/theseus-loop-status.test.ts scripts/codex-stop-guard.test.ts scripts/theseus-loop-policy.test.ts",
    "build": "npm run typecheck && vite build",
    "check:dev-review-production": "node --disable-warning=ExperimentalWarning scripts/check-dev-review-production-closure.ts",
    "check:reader-production": "node --disable-warning=ExperimentalWarning scripts/check-reader-production-closure.ts",
    "check:reader-budgets": "node --disable-warning=ExperimentalWarning scripts/check-reader-route-budgets.ts",
    "review:logs": "node --disable-warning=ExperimentalWarning scripts/dev-review-cli.ts",
    "verify:impact": "node --disable-warning=ExperimentalWarning scripts/verify-impact.ts",
    "typecheck": "tsc --project tsconfig.app.json --noEmit && tsc --project tsconfig.node.json --noEmit && tsc --project tsconfig.test.json --noEmit && npm run typecheck:domains",
    "check:architecture": "node --disable-warning=ExperimentalWarning scripts/check-concept-room-boundaries.ts && node --disable-warning=ExperimentalWarning scripts/check-semantic-reader-boundaries.ts",
    "check:reader-parser-isolation": "node --disable-warning=ExperimentalWarning scripts/check-semantic-reader-parser-isolation.ts",
    "check:inference": "node --disable-warning=ExperimentalWarning scripts/check-inference-contracts.ts",
    "generate:concept-catalog": "node --disable-warning=ExperimentalWarning scripts/generate-concept-catalog.ts",
    "check:concept-catalog": "node --disable-warning=ExperimentalWarning scripts/generate-concept-catalog.ts --check",
    "typecheck:protocols": "tsc --project protocols/tsconfig.json --noEmit",
    "typecheck:domains": "tsc --project domains/tsconfig.json --noEmit",
    "typecheck:linear-provider": "tsc --project providers/linear-problems/tsconfig.json --noEmit",
    "test": "npm run check:architecture && npm run check:inference && npm run check:concept-catalog && node --disable-warning=ExperimentalWarning --test server/*.test.ts tests/*.test.ts",
    "preview": "vite preview --port 8000 --strictPort",
    "test:browser:katex": "playwright test tests/katex-transition.browser.spec.ts --project=chromium",
    "test:browser:linear-equation-conformance": "playwright test tests/linear-equation-symbolic-conformance.browser.spec.ts --project=chromium",
    "test:browser:reader-conformance": "playwright test tests/semantic-reader-shared-conformance.browser.spec.ts --project=chromium --workers=1",
    "test:browser:dashboard": "playwright test tests/project-dashboard.browser.spec.ts --project=chromium",
    "smoke:linear-equation": "playwright test tests/linear-equation-concept-room-smoke.browser.spec.ts --project=chromium",
    "visual:editor-cards": "node --disable-warning=ExperimentalWarning scripts/capture-editor-cards.ts",
    "visual:linear-equation": "node --disable-warning=ExperimentalWarning scripts/capture-linear-equation-visual-baseline.ts",
    "visual:cancellation": "playwright test tests/semantic-reader-cancellation.browser.spec.ts tests/semantic-reader-divide-both-sides.browser.spec.ts tests/semantic-reader-presentation-profile.browser.spec.ts tests/equation-canonical-cross-surface-parity.browser.spec.ts --project=chromium --workers=1",
    "visual:distribution-area": "playwright test tests/semantic-reader-distribution-area.browser.spec.ts --project=chromium --workers=1",
    "visual:exponent-radical": "node --disable-warning=ExperimentalWarning scripts/capture-exponent-radical-visual.ts",
    "visual:function-wrap": "node --disable-warning=ExperimentalWarning scripts/capture-function-wrap-visual.ts",
    "visual:contact-sheet": "node --disable-warning=ExperimentalWarning scripts/capture-visual-contact-sheet.ts",
    "visual:reader-gold-parity": "npm run build && node --disable-warning=ExperimentalWarning scripts/capture-reader-gold-equation-parity.ts",
    "baseline:semantic-reader": "node --disable-warning=ExperimentalWarning scripts/capture-semantic-reader-baseline.ts",
    "baseline:solve-x-attention": "node --disable-warning=ExperimentalWarning scripts/capture-solve-x-attention-baseline.ts",
    "baseline:solve-x-handoff": "node --disable-warning=ExperimentalWarning scripts/capture-solve-x-handoff-baseline.ts",
    "baseline:fractional-linear-equation": "node --disable-warning=ExperimentalWarning scripts/capture-fractional-linear-equation-baseline.ts",
    "visual:fractional-linear-equation": "node --disable-warning=ExperimentalWarning scripts/check-fractional-linear-equation-visual.ts",
    "review:semantic-reader": "npm run build && node --disable-warning=ExperimentalWarning scripts/capture-semantic-reader-review.ts",
    "perf:linear-equation": "playwright test tests/linear-equation-audit.browser.spec.ts --project=chromium --workers=1",
    "perf:animation": "node --disable-warning=ExperimentalWarning scripts/animation-performance.ts",
    "perf:animation:strict": "node --disable-warning=ExperimentalWarning scripts/animation-performance.ts --strict-targets",
    "generate:animation-library-metadata": "node --disable-warning=ExperimentalWarning scripts/generate-animation-library-metadata.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@types/node": "^26.1.0",
    "@types/three": "^0.185.0",
    "mdast-util-from-markdown": "^2.0.3",
    "theseus": "file:../theseus",
    "typescript": "^6.0.3",
    "vite": "^8.1.3"
  },
  "dependencies": {
    "katex": "^0.17.0",
    "three": "^0.185.1"
  }
}
