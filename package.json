{
  "name": "kinetic-press",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "node --disable-warning=ExperimentalWarning scripts/dev.ts",
    "dev:client": "vite",
    "dev:server": "node --disable-warning=ExperimentalWarning --watch server/main.ts",
    "dashboard:extension": "node --disable-warning=ExperimentalWarning scripts/project-dashboard-extension.ts",
    "theseus": "theseus",
    "build": "npm run typecheck && vite build",
    "typecheck": "tsc --project tsconfig.app.json --noEmit && tsc --project tsconfig.node.json --noEmit && tsc --project tsconfig.test.json --noEmit",
    "check:architecture": "node --disable-warning=ExperimentalWarning scripts/check-concept-room-boundaries.ts",
    "test": "npm run check:architecture && node --disable-warning=ExperimentalWarning --test server/*.test.ts tests/*.test.ts",
    "preview": "vite preview --port 8000 --strictPort",
    "test:browser:katex": "playwright test tests/katex-transition.browser.spec.ts --project=chromium",
    "test:browser:dashboard": "playwright test tests/project-dashboard.browser.spec.ts --project=chromium",
    "perf:animation": "node --disable-warning=ExperimentalWarning scripts/animation-performance.ts",
    "perf:animation:strict": "node --disable-warning=ExperimentalWarning scripts/animation-performance.ts --strict-targets",
    "generate:animation-library-metadata": "node --disable-warning=ExperimentalWarning scripts/generate-animation-library-metadata.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@types/node": "^26.1.0",
    "@types/three": "^0.185.0",
    "typescript": "^6.0.3",
    "vite": "^8.1.3",
    "theseus": "file:../theseus"
  },
  "dependencies": {
    "katex": "^0.17.0",
    "three": "^0.185.1"
  }
}
